# NeuroSaathi - Environment Configuration Template
# For SIH 2026 Hackathon Demo

# Flask Server Config
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000

# SQLite / Firebase Adapter
DATABASE_URL=sqlite:///backend/models/neurosaathi.db
FIREBASE_SYNC_ENABLED=false
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=your-private-key

# Client App
VITE_API_BASE_URL=http://127.0.0.1:5000/api
VITE_DEFAULT_LANGUAGE=en
